# ─── Google Gemini (Zorunlu — online supervisor için) ─────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ─── Anthropic Claude (İsteğe Bağlı) ─────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Supervisor Seçimi ────────────────────────────────────────────────────
# "auto"   → İnternet varsa Gemini, yoksa en iyi yerel model (ÖNERİLEN)
# "gemini" → Her zaman Gemini
# "claude" → Her zaman Claude
# "ollama" → Her zaman yerel model
SUPERVISOR_PROVIDER=auto

# ─── Ollama ───────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ─── Model Atamaları ─────────────────────────────────────────────────────
CODER_MODEL=qwen2.5-coder:14b
RESEARCHER_MODEL=gemma3:12b
FAST_MODEL=qwen2.5-coder:1.5b-base

# ─── Sunucu ──────────────────────────────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8000

# ─── Vector Bellek (ChromaDB) ────────────────────────────────────────────
CHROMA_PATH=./chroma_db

# ─── Çalışma Alanı ───────────────────────────────────────────────────────
WORKSPACE_DIR=workspace
