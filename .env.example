# Atlas — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)

# ─── Zorunlu (en az biri gerekli) ────────────────────────────────────────────
GOOGLE_API_KEY=           # Gemini 2.5 Flash/Pro — https://aistudio.google.com/app/apikey
ANTHROPIC_API_KEY=        # Claude Sonnet — https://console.anthropic.com/

# ─── Opsiyonel API Anahtarları ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=      # Google Maps Distance Matrix — https://console.cloud.google.com/

# ─── MCP Sunucu Anahtarları ───────────────────────────────────────────────────
FIRECRAWL_API_KEY=        # Firecrawl scraping — https://www.firecrawl.dev/  (ucretsiz plan mevcut)
BRAVE_API_KEY=            # Brave Search — https://api.search.brave.com/      (2000 sorgu/ay ucretsiz)
APIFY_TOKEN=              # Apify 55+ scraper — https://apify.com/            (5$ ucretsiz kredi)

# ─── Sunucu Ayarları ──────────────────────────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8000

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ─── Supervisor Modu ──────────────────────────────────────────────────────────
# auto   → Internet + GOOGLE_API_KEY varsa Gemini, yoksa yerel model
# gemini → Yalnizca Gemini (GOOGLE_API_KEY gerekli)
# claude → Yalnizca Claude (ANTHROPIC_API_KEY gerekli)
# ollama → Yalnizca yerel Ollama
SUPERVISOR_PROVIDER=auto

# ─── Model Gecersiz Kilma (opsiyonel) ────────────────────────────────────────
# CODER_MODEL=qwen2.5-coder:14b
# REVIEWER_MODEL=qwen2.5-coder:14b
# TESTER_MODEL=qwen2.5-coder:14b
# RESEARCHER_MODEL=qwen3:14b
# DEBUGGER_MODEL=deepseek-r1:14b
# FAST_MODEL=qwen2.5-coder:1.5b-base
# VISION_MODEL=gemma4:26b
